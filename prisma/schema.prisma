generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

///////////////////////
// ENUMS
///////////////////////
enum NotificationType {
  REMINDER
  MOTIVATIONAL
  SYSTEM
  PROGRESS_CHECK
}

enum DreamStatus {
  DRAFT
  ACTIVE
  COMPLETED
  FAILED
  ARCHIVED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
  ARCHIVED
}

enum EventStatus {
  PENDING
  PROCESSED
  FAILED
}

enum NotificationStatus {
  SCHEDULED
  SENT
  FAILED
  ARCHIVED
  PROCESSING
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

enum MotivationTone {
  HARSH
  POSITIVE
  OPTIMISTIC
  FEAR
  LOGICAL
  NEUTRAL
}

///////////////////////
// USER & AUTH
///////////////////////

model User {
  id           String  @id @default(uuid())
  name         String?
  email        String  @unique
  passwordHash String
  timezone     String  @default("UTC")

  preferences       UserPreference?
  refreshTokens     RefreshToken[]
  dreams            Dream[]
  tasks             Task[]
  notifications     Notification[]
  logs              AppLog[]
  events            UserEvent[]
  pushSubscriptions PushSubscription[]
  insightSnapshots  UserInsightSnapshot[]
  generatedInsights GeneratedInsight[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserPreference {
  id     String @id @default(uuid())
  userId String @unique

  motivationTone        MotivationTone @default(NEUTRAL)
  notificationFrequency Int // minutes

  sleepStart String // "23:30"
  sleepEnd   String // "06:30"

  quietHours Json // [{ "start": "07:00", "end": "09:00" }]

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  token     String   @unique
  deviceInfo String? // Browser/OS info
  lastActiveAt DateTime @default(now())
  
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)
  replacedByToken String? // For rotation tracking
  
  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  endpoint  String   @unique
  p256dh    String
  auth      String
  
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

///////////////////////
// DREAM
///////////////////////

model Dream {
  id     String @id @default(uuid())
  userId String

  title               String
  description         String
  motivationStatement String? // emotional "why" behind the dream
  deadline            DateTime
  impactScore         Int

  status DreamStatus @default(DRAFT)

  user              User                  @relation(fields: [userId], references: [id])
  checkpoints       DreamCheckpoint[]
  tasks             Task[]
  notifications     Notification[]
  insightSnapshots  UserInsightSnapshot[]
  generatedInsights GeneratedInsight[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
}

model DreamCheckpoint {
  id      String @id @default(uuid())
  dreamId String

  title          String
  description    String?
  expectedEffort Int?
  miniDeadline   DateTime?
  orderIndex     Int
  isUserModified Boolean   @default(false)

  dream Dream @relation(fields: [dreamId], references: [id])

  createdAt DateTime @default(now())
}

///////////////////////
// TASK
///////////////////////

model Task {
  id      String @id @default(uuid())
  userId  String
  dreamId String

  title             String
  description       String?
  startDate         DateTime? // ✅ when reminders begin
  deadline          DateTime
  estimatedDuration Int?
  priority          Int
  status            TaskStatus     @default(PENDING)
  completedAt       DateTime? // ✅ when task was finished
  progressPercent   Int? // 0–100, nullable
  lastProgressAt    DateTime?
  user              User           @relation(fields: [userId], references: [id])
  dream             Dream          @relation(fields: [dreamId], references: [id])
  notifications     Notification[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  generatedInsights GeneratedInsight[]
  checkpoints       TaskCheckpoint[]
}

///////////////////////
// TASK CHECKPOINT (PHASE-1 CORE)
///////////////////////

enum CheckpointStatus {
  NOT_STARTED      // targetDate > today
  ACTIVE           // targetDate == today
  DUE              // targetDate < today && not completed
  COMPLETED
  EARLY_STARTED    // progress before targetDate
}

enum UserEventType {
  TASK_CREATED
  CHECKPOINT_STARTED
  CHECKPOINT_PROGRESS_UPDATED
  CHECKPOINT_COMPLETED
  TASK_COMPLETED
  NOTIFICATION_RECEIVED
  NOTIFICATION_CLICKED
  DAY_WITH_NO_ACTIVITY
}

///////////////////////
// TASK CHECKPOINT (PHASE-1 CORE)
///////////////////////

model TaskCheckpoint {
  id     String @id @default(uuid())
  taskId String

  title        String          // "Finish Chapter 1"
  targetDate   DateTime        // day this applies to
  orderIndex   Int
  isCompleted  Boolean @default(false)
  progress     Int     @default(0) // 0-100 (can exceed 100)
  status       CheckpointStatus @default(NOT_STARTED)
  
  isUserEdited Boolean @default(false)
  startedEarly Boolean @default(false)

  task Task @relation(fields: [taskId], references: [id])

  createdAt DateTime @default(now())
}

///////////////////////
// DOMAIN EVENTS (EVENT-DRIVEN CORE)
///////////////////////

model DomainEvent {
  id                String             @id @default(uuid())
  eventType         String
  payload           Json
  status            EventStatus        @default(PENDING)
  processedAt       DateTime? // ✅ idempotency & reliability
  generatedInsights GeneratedInsight[]
  createdAt         DateTime           @default(now())
}

///////////////////////
// APPLICATION LOGS (MOVED EVENTS HERE TO KEEP TOGETHER)
///////////////////////

model UserEvent {
  id         String @id @default(uuid())
  userId     String

  entityType String   // TASK | CHECKPOINT | NOTIFICATION
  entityId   String

  eventType  UserEventType
  metadata   Json?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

///////////////////////
// NOTIFICATIONS
///////////////////////

model Notification {
  id      String  @id @default(uuid())
  userId  String
  dreamId String?
  taskId  String?

  type        NotificationType
  message     String
  scheduledAt DateTime
  sentAt      DateTime? // ✅ when actually sent
  status      NotificationStatus @default(SCHEDULED)
  
  metadata    Json?     // ✅ Action buttons (Phase-1)

  retryCount    Int     @default(0)
  failureReason String?

  user  User   @relation(fields: [userId], references: [id])
  dream Dream? @relation(fields: [dreamId], references: [id])
  task  Task?  @relation(fields: [taskId], references: [id])

  createdAt DateTime @default(now())
}

///////////////////////
// APPLICATION LOGS
///////////////////////

model AppLog {
  id      String   @id @default(uuid())
  level   LogLevel
  source  String // auth | dream | task | notification | ai
  message String
  context Json?

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}




model UserInsightSnapshot {
  id       String @id @default(uuid())
  userId   String
  dreamId  String?

  weekStart DateTime
  weekEnd   DateTime

  // Activity
  activeDays        Int
  missedDays        Int
  longestStreak     Int
  currentStreak     Int

  // Execution
  totalCheckpointsPlanned    Int
  totalCheckpointsCompleted Int
  lateCheckpoints           Int
  earlyStarts               Int
  overachievementDays       Int

  // Effort
  avgDailyProgress        Float
  avgProgressLatencyHours Float

  // Visualization payloads
  dailyEffort Json    // { Mon: 120, Tue: 80, ... }
  dailyStatus Json    // { Mon: "HIGH", Tue: "LOW", ... }

  // Scores
  disciplineScore  Int  // 0–100
  consistencyScore Int  // 0–100

  finalizedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id])
  dream Dream? @relation(fields: [dreamId], references: [id])

  @@unique([userId, dreamId, weekStart])
}

model GeneratedInsight {
  id        String @id @default(uuid())
  userId    String
  dreamId   String?
  weekStart DateTime // Added to link to specific week

  insightType InsightType
  evidence   Json

  createdAt DateTime @default(now())
  consumed  Boolean @default(false)

  user          User         @relation(fields: [userId], references: [id])
  dream         Dream?       @relation(fields: [dreamId], references: [id])
  
  // Removed relations specific to Phase 1 that are no longer mentioned in the new spec or can be inferred
  // If we need to keep backward compatibility we might keep them optional, 
  // but strictly following the prompt "Modify usage as follows":
  // The prompt definition didn't show the relations, but Prisma requires relations for fields like userId/dreamId if they map to models.
  // I will keep the relations that exist for data integrity but align fields to the prompt.
  
  // Note: The prompt's GeneratedInsight definition didn't include taskId or domainEventId.
  // I will make them optional or remove if not needed. 
  // "stores LLM-generated explanations, not metrics"
  
  taskId          String?
  task            Task?        @relation(fields: [taskId], references: [id])
  domainEventId   String?
  domainEvent     DomainEvent? @relation(fields: [domainEventId], references: [id])

  @@index([userId, createdAt])
}

enum InsightType {
  TASK_AVOIDANCE_HIGH
  PROCRASTINATION_PATTERN
  MOTIVATION_DECAY
  DREAM_RESTART_LOOP
  HIGH_RESPONSE_LATENCY
  TONE_MISMATCH
  CONSISTENT_PROGRESS
  TASK_OVERLOAD
  DREAM_TASK_MISALIGNMENT
  USER_REFLECTION_TRIGGER
  WEEKLY_VERDICT // Added for weekly summary
}
