# ── LLM PROVIDERS ────────────────────────────────────────────────────────────
# Primary: OpenCode Zen — `space-bunny-free` is $0 for input, output and cached
# tokens, OpenAI-compatible, and zero-retention. Get a key at https://opencode.ai/auth
# Without it the app still boots; chat falls through to the other providers.
OPENCODE_API_KEY=
OPENCODE_MODEL="space-bunny-free"
# OPENCODE_BASE_URL="https://opencode.ai/zen/v1"

# Fallback providers. At least one LLM key must be set or chat returns 500.
GROQ_API_KEY=
GROQ_MODEL="llama-3.3-70b-versatile"
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
DEEPSEEK_API_KEY=

# Reasoning models (Zen) can take 10-30s on a cold prompt.
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
